# Salin ke .env (gitignored, izin 600) hanya bila memakai bot Telegram: `monev bot`.
# CLI, extension, dan /monev tidak butuh env apa pun. Jangan pernah commit .env.
# Panduan: docs/panduan/bot-telegram.md

# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# Lihat dengan: monev bot --chat-id
TELEGRAM_CHAT_ID=
