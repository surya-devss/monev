{
  "manifest_version": 3,
  "name": "Monev Kirim",
  "version": "0.2.0",
  "description": "Isi dan kirim laporan harian Monev MagangHub dari draft yang sudah disetujui lewat CLI monev. Tanpa menyimpan token atau password.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "scripting",
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://monev.maganghub.kemnaker.go.id/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Monev Kirim",
    "default_icon": {
      "16": "ikon/ikon-16.png",
      "32": "ikon/ikon-32.png"
    }
  },
  "icons": {
    "16": "ikon/ikon-16.png",
    "32": "ikon/ikon-32.png",
    "48": "ikon/ikon-48.png",
    "128": "ikon/ikon-128.png"
  }
}
